[Unit]
Description=HIM Education Walled Garden (all-in-one)
After=NetworkManager.service network-online.target
Wants=network-online.target
Conflicts=him-ap.service him-firewall.service him-webserver.service

[Service]
Type=simple
ExecStart=/opt/him-edu/start_ap.sh
ExecStop=/opt/him-edu/stop_ap.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
